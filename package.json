{
  "name": "boards-for-azure-devops",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "sotoru",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": { "color": "#0B5CAD", "theme": "dark" },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sotoru/boards-for-azure-devops"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "keywords": ["azure devops", "azure boards", "work items", "kanban", "ado"],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "package": "vsce package",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "board_azr_devops",
          "title": "%container.title%",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "board_azr_devops": [
        {
          "id": "board_azr_devops.items",
          "name": "%view.items%"
        },
        {
          "id": "board_azr_devops.queries",
          "name": "%view.queries%",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "board_azr_devops.items",
        "contents": "%view.welcome.noOrg%",
        "when": "board_azr_devops.noOrg"
      },
      {
        "view": "board_azr_devops.items",
        "contents": "%view.welcome.noTeam%",
        "when": "!board_azr_devops.noOrg && board_azr_devops.noTeam"
      },
      {
        "view": "board_azr_devops.items",
        "contents": "%view.welcome.emptyFiltered%",
        "when": "board_azr_devops.emptyFiltered"
      }
    ],
    "commands": [
      {
        "command": "board_azr_devops.refresh",
        "title": "%cmd.refresh%",
        "icon": "$(refresh)",
        "category": "Azure Boards"
      },
      {
        "command": "board_azr_devops.showAll",
        "title": "%cmd.showAll%",
        "icon": "$(people)",
        "category": "Azure Boards"
      },
      {
        "command": "board_azr_devops.showMine",
        "title": "%cmd.showMine%",
        "icon": "$(person)",
        "category": "Azure Boards"
      },
      {
        "command": "board_azr_devops.filter",
        "title": "%cmd.filter%",
        "icon": "$(filter)",
        "category": "Azure Boards"
      },
      {
        "command": "board_azr_devops.filterActive",
        "title": "%cmd.filter%",
        "icon": "$(filter-filled)"
      },
      {
        "command": "board_azr_devops.clearFilters",
        "title": "%cmd.clearFilters%",
        "icon": "$(clear-all)",
        "category": "Azure Boards"
      },
      {
        "command": "board_azr_devops.groupBy",
        "title": "%cmd.groupBy%",
        "icon": "$(list-tree)",
        "category": "Azure Boards"
      },
      {
        "command": "board_azr_devops.switchScope",
        "title": "%cmd.switchScope%",
        "category": "Azure Boards"
      },
      {
        "command": "board_azr_devops.open",
        "title": "%cmd.open%"
      },
      {
        "command": "board_azr_devops.preview",
        "title": "%cmd.preview%"
      },
      {
        "command": "board_azr_devops.setState",
        "title": "%cmd.setState%"
      },
      {
        "command": "board_azr_devops.setColumn",
        "title": "%cmd.setColumn%"
      },
      {
        "command": "board_azr_devops.setTitle",
        "title": "%cmd.setTitle%"
      },
      {
        "command": "board_azr_devops.assignMe",
        "title": "%cmd.assignMe%"
      },
      {
        "command": "board_azr_devops.comment",
        "title": "%cmd.comment%"
      },
      {
        "command": "board_azr_devops.newItem",
        "title": "%cmd.newItem%",
        "icon": "$(add)",
        "category": "Azure Boards"
      },
      {
        "command": "board_azr_devops.setPriority",
        "title": "%cmd.setPriority%"
      },
      {
        "command": "board_azr_devops.setTags",
        "title": "%cmd.setTags%"
      },
      {
        "command": "board_azr_devops.assign",
        "title": "%cmd.assign%"
      },
      {
        "command": "board_azr_devops.setIteration",
        "title": "%cmd.setIteration%"
      },
      {
        "command": "board_azr_devops.setParent",
        "title": "%cmd.setParent%"
      },
      {
        "command": "board_azr_devops.editDescription",
        "title": "%cmd.editDescription%"
      },
      {
        "command": "board_azr_devops.addChild",
        "title": "%cmd.addChild%"
      },
      {
        "command": "board_azr_devops.startWork",
        "title": "%cmd.startWork%",
        "icon": "$(git-branch)"
      },
      {
        "command": "board_azr_devops.openActive",
        "title": "%cmd.openActive%",
        "category": "Azure Boards"
      },
      {
        "command": "board_azr_devops.openBoard",
        "title": "%cmd.openBoard%",
        "icon": "$(project)",
        "category": "Azure Boards"
      },
      {
        "command": "board_azr_devops.copyForAi",
        "title": "%cmd.copyForAi%",
        "icon": "$(copy)"
      },
      {
        "command": "board_azr_devops.copyField",
        "title": "%cmd.copyField%",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "board_azr_devops.open",
          "when": "false"
        },
        {
          "command": "board_azr_devops.preview",
          "when": "false"
        },
        {
          "command": "board_azr_devops.setState",
          "when": "false"
        },
        {
          "command": "board_azr_devops.setColumn",
          "when": "false"
        },
        {
          "command": "board_azr_devops.setTitle",
          "when": "false"
        },
        {
          "command": "board_azr_devops.assignMe",
          "when": "false"
        },
        {
          "command": "board_azr_devops.comment",
          "when": "false"
        },
        {
          "command": "board_azr_devops.filterActive",
          "when": "false"
        },
        {
          "command": "board_azr_devops.setPriority",
          "when": "false"
        },
        {
          "command": "board_azr_devops.setTags",
          "when": "false"
        },
        {
          "command": "board_azr_devops.assign",
          "when": "false"
        },
        {
          "command": "board_azr_devops.setIteration",
          "when": "false"
        },
        {
          "command": "board_azr_devops.setParent",
          "when": "false"
        },
        {
          "command": "board_azr_devops.editDescription",
          "when": "false"
        },
        {
          "command": "board_azr_devops.addChild",
          "when": "false"
        },
        {
          "command": "board_azr_devops.startWork",
          "when": "false"
        },
        {
          "command": "board_azr_devops.copyForAi",
          "when": "false"
        },
        {
          "command": "board_azr_devops.copyField",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "board_azr_devops.startWork",
          "when": "viewItem == workItem",
          "group": "0_work@1"
        },
        {
          "submenu": "board_azr_devops.editField",
          "when": "viewItem == workItem",
          "group": "1_edit@1"
        },
        {
          "command": "board_azr_devops.editDescription",
          "when": "viewItem == workItem",
          "group": "1_edit@2"
        },
        {
          "command": "board_azr_devops.comment",
          "when": "viewItem == workItem",
          "group": "1_edit@3"
        },
        {
          "command": "board_azr_devops.addChild",
          "when": "viewItem == workItem",
          "group": "1_edit@4"
        },
        {
          "command": "board_azr_devops.preview",
          "when": "viewItem == workItem",
          "group": "2_open@1"
        },
        {
          "command": "board_azr_devops.open",
          "when": "viewItem == workItem",
          "group": "2_open@2"
        },
        {
          "command": "board_azr_devops.copyForAi",
          "when": "viewItem == workItem",
          "group": "3_ai@1"
        },
        {
          "command": "board_azr_devops.copyField",
          "when": "viewItem == field",
          "group": "inline"
        },
        {
          "command": "board_azr_devops.copyField",
          "when": "viewItem == field",
          "group": "1_copy"
        }
      ],
      "view/title": [
        {
          "command": "board_azr_devops.newItem",
          "when": "view == board_azr_devops.items && !board_azr_devops.noOrg",
          "group": "navigation@0"
        },
        {
          "command": "board_azr_devops.showAll",
          "when": "view == board_azr_devops.items && board_azr_devops.mode != all",
          "group": "navigation@1"
        },
        {
          "command": "board_azr_devops.showMine",
          "when": "view == board_azr_devops.items && board_azr_devops.mode == all",
          "group": "navigation@1"
        },
        {
          "command": "board_azr_devops.filter",
          "when": "view == board_azr_devops.items && !board_azr_devops.filtered",
          "group": "navigation@2"
        },
        {
          "command": "board_azr_devops.filterActive",
          "when": "view == board_azr_devops.items && board_azr_devops.filtered",
          "group": "navigation@2"
        },
        {
          "command": "board_azr_devops.clearFilters",
          "when": "view == board_azr_devops.items && board_azr_devops.filtered",
          "group": "navigation@3"
        },
        {
          "command": "board_azr_devops.groupBy",
          "when": "view == board_azr_devops.items",
          "group": "navigation@4"
        },
        {
          "command": "board_azr_devops.openBoard",
          "when": "view == board_azr_devops.items && !board_azr_devops.noOrg",
          "group": "navigation@5"
        },
        {
          "command": "board_azr_devops.refresh",
          "when": "view == board_azr_devops.items",
          "group": "navigation@6"
        },
        {
          "command": "board_azr_devops.switchScope",
          "when": "view == board_azr_devops.items",
          "group": "9_scope"
        },
        {
          "command": "board_azr_devops.refresh",
          "when": "view == board_azr_devops.queries",
          "group": "navigation@1"
        }
      ],
      "board_azr_devops.editField": [
        {
          "command": "board_azr_devops.setState",
          "group": "1@0"
        },
        {
          "command": "board_azr_devops.setColumn",
          "group": "1@0"
        },
        {
          "command": "board_azr_devops.setTitle",
          "group": "1@1"
        },
        {
          "command": "board_azr_devops.setPriority",
          "group": "1@2"
        },
        {
          "command": "board_azr_devops.setTags",
          "group": "1@3"
        },
        {
          "command": "board_azr_devops.assign",
          "group": "1@4"
        },
        {
          "command": "board_azr_devops.assignMe",
          "group": "1@5"
        },
        {
          "command": "board_azr_devops.setIteration",
          "group": "1@6"
        },
        {
          "command": "board_azr_devops.setParent",
          "group": "1@7"
        }
      ]
    },
    "configuration": {
      "title": "Azure Boards",
      "properties": {
        "board_azr_devops.organizations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.organizations%"
        },
        "board_azr_devops.query": {
          "type": "string",
          "default": "SELECT [System.Id] FROM WorkItems WHERE [System.AssignedTo] = @Me AND [System.State] NOT IN ('Closed','Done','Removed','Resolved') ORDER BY [System.ChangedDate] DESC",
          "description": "%config.query%"
        },
        "board_azr_devops.refreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "%config.refreshMinutes%"
        },
        "board_azr_devops.notifyAssigned": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyAssigned%"
        },
        "board_azr_devops.branchTemplate": {
          "type": "string",
          "default": "{type}/{id}",
          "markdownDescription": "%config.branchTemplate%"
        },
        "board_azr_devops.baseBranch": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.baseBranch%"
        },
        "board_azr_devops.commitReference": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.commitReference%"
        },
        "board_azr_devops.registerMcp": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.registerMcp%"
        }
      }
    },
    "submenus": [
      {
        "id": "board_azr_devops.editField",
        "label": "%submenu.editField%"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "board_azr_devops.mcp",
        "label": "Azure DevOps (Boards for Azure DevOps)"
      }
    ]
  }
}
